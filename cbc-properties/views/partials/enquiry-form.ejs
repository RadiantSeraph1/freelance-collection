<% if (errors.length) { %><ul class="errors"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
<form method="post" action="/enquiries" class="stack">
  <% if (locals.plot && plot) { %><input type="hidden" name="plot_id" value="<%= plot.id %>"><% } %>
  <label>Your name <input name="name" required maxlength="100" autocomplete="name" value="<%= form.name || '' %>"></label>
  <div class="row">
    <label>Phone / WhatsApp <input name="phone" type="tel" maxlength="30" autocomplete="tel" value="<%= form.phone || '' %>"></label>
    <label>Email <input name="email" type="email" maxlength="120" autocomplete="email" value="<%= form.email || '' %>"></label>
  </div>
  <label>Message <textarea name="message" rows="4" maxlength="2000" placeholder="<%= locals.plot && plot ? 'I would like to visit this plot…' : 'Which estate or budget are you considering?' %>"><%= form.message || '' %></textarea></label>
  <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
  <button class="btn block"><%- icon('send') %> Send enquiry</button>
</form>
