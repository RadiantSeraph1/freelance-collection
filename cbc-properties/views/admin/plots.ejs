<%- include('../partials/head') %>
<%- include('nav') %>
  <div class="bar"><h1>Plots</h1><a class="btn" href="/admin/plots/new">Add a plot</a></div>
  <form class="filters" action="/admin/plots">
    <label>Estate <select name="estate"><option value="">All</option><% estates.forEach((e) => { %><option value="<%= e.id %>" <%= f.estate === e.id ? 'selected' : '' %>><%= e.name %></option><% }) %></select></label>
    <label>Status <select name="status"><option value="">All</option><% PLOT_STATUSES.forEach((s) => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
    <div class="actions"><button class="btn">Filter</button> <a href="/admin/plots">Clear</a></div>
  </form>
  <% if (plots.length) { %>
  <table>
    <thead><tr><th>Ref</th><th>Estate</th><th>Dimensions</th><th class="num">Price</th><th>Status</th><th>Demarcation</th><th>Customer</th><th></th></tr></thead>
    <tbody><% plots.forEach((p) => { %><tr>
      <td><a href="/plots/<%= p.id %>"><%= p.ref %></a></td><td><%= p.estate_name %></td><td><%= p.dimensions %></td>
      <td class="num"><%= money(p.price) %></td>
      <td><span class="tag <%= p.status === 'available' ? 'ok' : p.status === 'reserved' ? 'warn' : '' %>"><%= label(p.status) %></span></td>
      <td><%= label(p.demarcation) %></td>
      <td><% if (p.sale_id) { %><a href="/admin/sales/<%= p.sale_id %>"><%= p.customer %></a><% } else { %>–<% } %></td>
      <td><a href="/admin/plots/<%= p.id %>/edit">Edit</a><% if (p.status === 'available') { %> · <a href="/admin/sales/new?plot=<%= p.id %>">Reserve</a><% } %></td>
    </tr><% }) %></tbody>
  </table>
  <% } else { %><p class="empty">No plots match.</p><% } %>
</div>
<%- include('../partials/foot') %>
