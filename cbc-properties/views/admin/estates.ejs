<%- include('../partials/head') %>
<%- include('nav') %>
  <h1>Estates</h1>
  <table>
    <thead><tr><th>Code</th><th>Name</th><th>Location</th><th class="num">Plots</th><th></th></tr></thead>
    <tbody><% estates.forEach((e) => { %><tr>
      <td><%= e.code %></td><td><%= e.name %></td><td><%= e.location %></td><td class="num"><%= e.plots %></td>
      <td><a href="/admin/plots?estate=<%= e.id %>">View plots</a> · <a href="/admin/plots/new?estate=<%= e.id %>">Add plot</a></td>
    </tr><% }) %></tbody>
  </table>
  <h2>Add an estate</h2>
  <% if (errors.length) { %><ul class="errors"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
  <form method="post" action="/admin/estates" class="stack panel wide">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row">
      <label>Code (used in plot references) <input name="code" required maxlength="6" placeholder="e.g. OYH"></label>
      <label>Name <input name="name" required maxlength="80"></label>
      <label>Location <input name="location" required maxlength="80"></label>
    </div>
    <label>Description <textarea name="description" rows="3" maxlength="1000"></textarea></label>
    <button class="btn">Add estate</button>
  </form>
</div>
<%- include('../partials/foot') %>
