<%- include('partials/head') %>
<section class="hero small left">
  <img class="cover" src="/img/ld-plot-grass-lg.jpg" alt="" fetchpriority="high">
  <div class="container"><span class="eyebrow">Get in touch</span><h1>Book a site visit</h1></div>
</section>
<section class="section">
  <div class="container split start">
    <div>
      <h2>We reply the same day</h2>
      <p class="lead">Tell us which estate or budget you have in mind and an agent will arrange a visit.</p>
      <ul class="checklist">
        <li><%- icon('phone') %><div><strong>Call</strong><br><a href="tel:<%= site.phone.replace(/[^\d+]/g, '') %>"><%= site.phone %></a></div></li>
        <li><%- icon('message-circle') %><div><strong>WhatsApp</strong><br><a href="<%= waLink('Hello, I would like to ask about your plots.') %>" rel="noopener">Start a chat</a></div></li>
        <li><%- icon('mail') %><div><strong>Email</strong><br><a href="mailto:<%= site.email %>"><%= site.email %></a></div></li>
        <li><%- icon('map-pin') %><div><strong>Visit</strong><br><%= site.address %></div></li>
      </ul>
    </div>
    <div class="form-card"><%- include('partials/enquiry-form', { plot: null }) %></div>
  </div>
</section>
<%- include('partials/foot') %>
