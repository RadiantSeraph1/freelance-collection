<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (me) { %><meta name="robots" content="noindex"><% } %>
  <title><%= title %><% if (title !== site.name) { %> | <%= site.name %><% } %></title>
  <meta name="description" content="Managed apartments and houses to rent in Accra, with online viewings, tenant and landlord portals.">
  <link rel="stylesheet" href="/kit.css">
  <link rel="stylesheet" href="/theme.css">
</head>
<% if (me) { %>
<body class="app">
<% const here = (p) => path === p || path.startsWith(p + '/'); const cur = (ok) => (ok ? 'aria-current="page"' : ''); %>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" href="<%= me.role === 'manager' ? '/admin' : '/portal' %>"><span class="brand-mark">F</span><span><%= site.name.split(' ')[0] %></span></a>
    <nav class="side-nav" aria-label="Main">
      <% if (me.role === 'manager') { %>
        <span class="label">Overview</span>
        <a href="/admin" <%- cur(path === '/admin' || path === '/admin/') %>><%- icon('layout-dashboard') %> Dashboard</a>
        <a href="/admin/rent" <%- cur(here('/admin/rent') || here('/admin/tenancies')) %>><%- icon('banknote') %> Rent</a>
        <span class="label">Portfolio</span>
        <a href="/admin/properties" <%- cur(here('/admin/properties') || here('/admin/units')) %>><%- icon('building-2') %> Properties</a>
        <a href="/admin/maintenance" <%- cur(here('/admin/maintenance')) %>><%- icon('wrench') %> Maintenance</a>
        <a href="/admin/inspections" <%- cur(here('/admin/inspections')) %>><%- icon('clipboard-check') %> Inspections</a>
        <a href="/admin/viewings" <%- cur(here('/admin/viewings')) %>><%- icon('calendar-check') %> Viewings</a>
        <span class="label">Owners &amp; people</span>
        <a href="/admin/statements" <%- cur(here('/admin/statements')) %>><%- icon('receipt') %> Statements</a>
        <a href="/admin/people" <%- cur(here('/admin/people')) %>><%- icon('users') %> People</a>
      <% } else if (me.role === 'landlord') { %>
        <span class="label">Landlord</span>
        <a href="/portal" <%- cur(path === '/portal' || path === '/portal/' || here('/portal/properties') || here('/portal/inspections')) %>><%- icon('building-2') %> My properties</a>
        <a href="/portal/statements" <%- cur(here('/portal/statements')) %>><%- icon('receipt') %> Statements</a>
      <% } else { %>
        <span class="label">Tenant</span>
        <a href="/portal" <%- cur(path === '/portal' || path === '/portal/' || here('/portal/maintenance')) %>><%- icon('house') %> My tenancy</a>
      <% } %>
      <span class="label">Account</span>
      <a href="/account/password" <%- cur(here('/account/password')) %>><%- icon('lock') %> Password</a>
      <a href="/vacancies" target="_blank" rel="noopener"><%- icon('external-link') %> Public website</a>
    </nav>
    <div class="side-foot">
      <div class="who"><span class="avatar"><%= initials(me.name) %></span><div><b><%= me.name %></b><span class="muted small"><%= me.role === 'manager' ? 'Office' : me.role === 'landlord' ? 'Landlord' : 'Tenant' %></span></div></div>
      <form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link"><%- icon('log-out') %> Sign out</button></form>
    </div>
  </aside>
  <div class="app-main">
    <% if (site.demo) { %><div class="app-demo">Demonstration data.<% if (site.temporary) { %> Changes you make here are temporary and may disappear.<% } %></div><% } %>
    <div class="page">
<% } else { %>
<body>
<% if (site.demo) { %><div class="demo-banner">Demonstration prepared by Radiant InnovaTech. Landlords, tenants, properties and figures shown are sample data.<% if (site.temporary) { %> Changes you make here are temporary and may disappear.<% } %></div><% } %>
<div class="utility"><div class="container">
  <span class="hide-sm"><%- icon('map-pin') %> <%= site.address %></span>
  <span class="cluster"><a href="tel:<%= site.phone.replace(/[^\d+]/g, '') %>"><%- icon('phone') %> <%= site.phone %></a><a class="hide-sm" href="mailto:<%= site.email %>"><%- icon('mail') %> <%= site.email %></a></span>
</div></div>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/"><span class="brand-mark">F</span><span><%= site.name.split(' ')[0] %><small><%= site.name.split(' ').slice(1).join(' ') || 'Realty' %></small></span></a>
    <button class="nav-toggle" data-nav-toggle aria-label="Menu" aria-expanded="false"><%- icon('menu') %></button>
    <nav class="main-nav" aria-label="Main">
      <a href="/vacancies">Available to rent</a>
      <a href="/#how">For landlords</a>
      <a class="btn sm outline" href="/login"><%- icon('lock') %> Sign in</a>
    </nav>
  </div>
</header>
<main>
<% } %>
