<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <div class="bar"><h1>Maintenance</h1><a class="btn" href="/admin/maintenance/new">Log a repair request</a></div>
  <form class="filters" action="/admin/maintenance">
    <label>Status <select name="status"><option value="active" <%= f.status === 'active' ? 'selected' : '' %>>All open</option><% REQUEST_STATUSES.forEach((s) => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
    <label>Priority <select name="priority"><option value="">Any</option><% PRIORITIES.forEach((s) => { %><option value="<%= s %>" <%= f.priority === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
    <label>Property <select name="property"><option value="">Any</option><% properties.forEach((p) => { %><option value="<%= p.id %>" <%= f.property === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %></select></label>
    <div class="actions"><button class="btn">Filter</button> <a href="/admin/maintenance">Clear</a></div>
  </form>
  <%- include('../partials/requests-table', { requests, base: '/admin/maintenance' }) %>
</div>
<%- include('../partials/foot') %>
