<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <p><a class="arrow-link small" href="/admin/maintenance">← Maintenance</a></p>
  <h1><%= request.title %> <span class="badge <%= request.priority === 'urgent' ? 'bad' : '' %>"><%= label(request.priority) %></span></h1>
  <p class="muted"><a href="/admin/units/<%= request.unit_id %>"><%= request.property_name %>, unit <%= request.unit_label %></a> · Reported <%= request.created_at.slice(0, 10) %> by <%= request.reporter_name || 'the office' %></p>
  <% if (errors.length) { %><ul class="errors"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
  <div class="two">
    <div>
      <h2>Details</h2>
      <p class="desc"><%= request.description || 'No details given.' %></p>
      <h2>History</h2>
      <% if (notes.length) { %><ul class="notes"><% notes.forEach((n) => { %><li><span class="muted"><%= n.created_at %> UTC · <%= n.author %></span><br><%= n.note %></li><% }) %></ul><% } else { %><p class="muted">No notes.</p><% } %>
    </div>
    <form method="post" action="/admin/maintenance/<%= request.id %>" class="stack form-card">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2>Update</h2>
      <div class="row">
        <label>Status <select name="status"><% REQUEST_STATUSES.forEach((s) => { %><option value="<%= s %>" <%= request.status === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
        <label>Priority <select name="priority"><% PRIORITIES.forEach((s) => { %><option value="<%= s %>" <%= request.priority === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
      </div>
      <label>Contractor <input name="contractor" maxlength="100" value="<%= request.contractor %>"></label>
      <div class="row">
        <label>Cost <input name="cost" type="number" min="0" value="<%= request.cost %>"></label>
        <label>Currency <select name="cost_currency"><% CURRENCIES.forEach((c) => { %><option <%= request.cost_currency === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
        <label>Completed on <input name="completed_on" type="date" max="<%= todayDate %>" value="<%= request.completed_on || '' %>"></label>
      </div>
      <label class="check"><input type="checkbox" name="charge_landlord" value="1" <%= request.charge_landlord ? 'checked' : '' %>> Deduct this cost from the landlord’s statement</label>
      <label>Add a note <textarea name="note" rows="3" maxlength="1000"></textarea></label>
      <button class="btn">Save</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
