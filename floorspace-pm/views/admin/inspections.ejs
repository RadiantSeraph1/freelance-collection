<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <div class="bar"><h1>Inspections</h1><a class="btn" href="/admin/inspections/new">Record an inspection</a></div>
  <% if (inspections.length) { %>
  <table>
    <thead><tr><th>Date</th><th>Unit</th><th>Type</th><th>Inspector</th><th class="num">Fair</th><th class="num">Poor</th></tr></thead>
    <tbody><% inspections.forEach((i) => { %><tr><td><a href="/admin/inspections/<%= i.id %>"><%= i.inspected_on %></a></td><td><%= i.property_name %>, <%= i.label %></td><td><%= label(i.kind) %></td><td><%= i.inspector %></td>
      <td class="num"><%= i.fair %></td><td class="num <%= i.poor ? 'overdue' : '' %>"><%= i.poor %></td></tr><% }) %></tbody>
  </table>
  <% } else { %><p class="empty">No inspections recorded yet.</p><% } %>
</div>
<%- include('../partials/foot') %>
