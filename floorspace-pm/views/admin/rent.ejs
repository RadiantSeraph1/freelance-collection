<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <div class="bar"><h1>Rent</h1><a href="/admin/rent-roll.csv">Download rent roll (CSV)</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Tenant</th><th>Property</th><th class="num">Rent</th><th>Due day</th><th class="num">Overdue</th><th class="num">Days late</th><th>Status</th><th>Last reminder</th><th></th></tr></thead>
    <tbody><% rows.forEach((t) => { %><tr>
      <td><a href="/admin/tenancies/<%= t.id %>"><%= t.tenant_name %></a></td>
      <td><%= t.property_name %>, <%= t.unit_label %></td>
      <td class="num"><%= money(t.rent, t.currency) %></td><td><%= t.due_day %></td>
      <td class="num <%= t.l.overdue ? 'overdue' : '' %>"><%= money(t.l.overdue, t.currency) %></td><td class="num"><%= t.l.daysOverdue || '–' %></td>
      <td><% if (t.l.overdue) { %><span class="badge bad">Overdue</span><% } else if (t.l.balance < 0) { %><span class="badge ok">In credit</span><% } else if (t.l.nextDue) { %><span class="badge plain">Due <%= t.l.nextDue.date %></span><% } else { %><span class="badge ok">Up to date</span><% } %></td>
      <td><%= t.lastReminder || 'Never' %></td>
      <td class="inline"><% if (t.l.overdue && t.tenant_phone) { %><a href="<%= waLink(t.tenant_phone, reminderText(t)) %>" rel="noopener">WhatsApp</a>
        <form method="post" action="/admin/tenancies/<%= t.id %>/reminders"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="rent"><button class="link">Log sent</button></form><% } %></td>
    </tr><% }) %></tbody>
  </table></div>
  <p class="muted">Payments are applied to the oldest unpaid month first. Amounts in different currencies are never added together.</p>
</div>
<%- include('../partials/foot') %>
