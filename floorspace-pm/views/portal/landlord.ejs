<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <% const sum = (o) => Object.keys(o).length ? Object.keys(o).map((c) => money(o[c], c)).join(' + ') : 'None'; %>
  <h1>My properties</h1>
  <div class="stats">
    <div class="stat <%= Object.keys(arrears).length ? 'alert' : '' %>"><b><%= sum(arrears) %></b>Rent currently overdue</div>
    <div class="stat"><b><%= occupied %> of <%= units %></b>Units let</div>
    <div class="stat"><b><%= requests.length %></b>Open repairs</div>
  </div>
  <% properties.forEach((p) => { %>
  <h2><a href="/portal/properties/<%= p.id %>"><%= p.name %></a> <span class="muted">· <%= p.area %></span></h2>
  <table>
    <thead><tr><th>Unit</th><th>Tenant</th><th class="num">Rent</th><th>Rent status</th></tr></thead>
    <tbody><% p.units.forEach((u) => { %><tr>
      <td><%= u.label %></td><td><%= u.tenant_name || 'Vacant' %></td><td class="num"><%= u.tenancy_id ? money(u.rent, u.rent_currency) : '–' %></td>
      <td><% if (u.l) { %><% if (u.l.overdue) { %><span class="tag bad">Overdue <%= money(u.l.overdue, u.rent_currency) %></span><% } else { %><span class="tag ok">Up to date</span><% } %><% } else { %><span class="tag warn">Vacant</span><% } %></td>
    </tr><% }) %></tbody>
  </table>
  <% }) %>
  <% if (!properties.length) { %><p class="empty">No properties are linked to your account yet.</p><% } %>
  <h2>Open repairs</h2>
  <%- include('../partials/requests-table', { requests, base: '/portal/maintenance' }) %>
</div>
<%- include('../partials/foot') %>
