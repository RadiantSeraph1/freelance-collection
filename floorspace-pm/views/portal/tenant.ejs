<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <h1>My tenancy</h1>
  <% if (!tenancy) { %><p class="empty">You do not have a tenancy on record yet. Please contact the office.</p><% } else { const cur = tenancy.currency; %>
  <p class="muted"><%= tenancy.property_name %>, unit <%= tenancy.unit_label %> · Rent <%= money(tenancy.rent, cur) %> due on day <%= tenancy.due_day %> of each month<%= tenancy.end_date ? ' · Lease ends ' + tenancy.end_date : '' %><%= tenancy.status === 'ended' ? ' · Tenancy ended ' + tenancy.ended_on : '' %></p>
  <%- include('../partials/stats', { l, cur }) %>
  <% if (l.nextDue && !l.overdue) { %><p class="note">Your next rent payment of <%= money(l.nextDue.amount, cur) %> is due on <%= l.nextDue.date %>.</p><% } %>
  <div class="two">
    <div>
      <h2>Rent statement</h2>
      <%- include('../partials/ledger', { l, cur }) %>
      <h2>Payments we have received</h2>
      <% if (l.payments.length) { %><table><thead><tr><th>Date</th><th>Method</th><th>Reference</th><th class="num">Amount</th></tr></thead>
      <tbody><% l.payments.slice().reverse().forEach((p) => { %><tr><td><%= p.paid_on %></td><td><%= p.method %></td><td><%= p.reference || '–' %></td><td class="num"><%= money(p.amount, cur) %></td></tr><% }) %></tbody></table>
      <% } else { %><p class="muted">No payments recorded yet.</p><% } %>
    </div>
    <div>
      <% if (tenancy.status === 'active') { %>
      <h2>Report a problem</h2>
      <% if (errors.length) { %><ul class="errors"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
      <form method="post" action="/portal/maintenance" class="stack panel">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>What is wrong? <input name="title" required maxlength="120" value="<%= form.title || '' %>" placeholder="e.g. Kitchen tap leaking"></label>
        <label>Details <textarea name="description" rows="3" maxlength="2000"><%= form.description || '' %></textarea></label>
        <label>How urgent is it? <select name="priority"><% PRIORITIES.forEach((p) => { %><option value="<%= p %>" <%= (form.priority || 'normal') === p ? 'selected' : '' %>><%= label(p) %></option><% }) %></select></label>
        <button class="btn">Send to the office</button>
      </form>
      <% } %>
      <h2>My requests</h2>
      <%- include('../partials/requests-table', { requests, base: '/portal/maintenance' }) %>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
