<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (me) { %><meta name="robots" content="noindex"><% } %>
  <title><%= title %><% if (title !== site.name) { %> | <%= site.name %><% } %></title>
  <meta name="description" content="Construction, architecture, property management and real estate in Accra.">
  <link rel="stylesheet" href="/kit.css">
  <link rel="stylesheet" href="/theme.css">
</head>
<% if (me) { %>
<body class="app">
<% const cur = (ok) => (ok ? 'aria-current="page"' : ''); const here = (p) => path === p || path.startsWith(p + '/'); %>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" href="/admin"><span class="brand-mark">M</span><span><%= site.name.split(' ')[0] %></span></a>
    <nav class="side-nav" aria-label="Main">
      <span class="label">Leads</span>
      <a href="/admin" <%- cur(path === '/admin' || path === '/admin/') %>><%- icon('layout-dashboard') %> <%= me.role === 'admin' ? 'Dashboard' : 'My day' %></a>
      <a href="/admin/pipeline" <%- cur(here('/admin/pipeline')) %>><%- icon('square-kanban') %> Pipeline</a>
      <a href="/admin/leads" <%- cur(here('/admin/leads') && path !== '/admin/leads/new') %>><%- icon('inbox') %> All leads</a>
      <a href="/admin/leads/new" <%- cur(path === '/admin/leads/new') %>><%- icon('plus') %> Log a lead</a>
      <% if (me.role === 'admin') { %>
      <span class="label">Manage</span>
      <a href="/admin/reports" <%- cur(here('/admin/reports')) %>><%- icon('chart-column') %> Reports</a>
      <a href="/admin/team" <%- cur(here('/admin/team')) %>><%- icon('users') %> Team</a>
      <% } %>
      <a href="/" target="_blank" rel="noopener"><%- icon('external-link') %> Public enquiry page</a>
    </nav>
    <div class="side-foot">
      <div class="who"><span class="avatar"><%= initials(me.name) %></span><div><b><%= me.name %></b><span class="muted small"><%= me.role === 'admin' ? 'Manager' : 'Agent' %></span></div></div>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link"><%- icon('log-out') %> Sign out</button></form>
    </div>
  </aside>
  <div class="app-main">
    <% if (site.demo) { %><div class="app-demo">Demonstration data.<% if (site.temporary) { %> Changes you make here are temporary and may disappear.<% } %></div><% } %>
    <div class="page">
<% } else { %>
<body>
<% if (site.demo) { %><div class="demo-banner">Demonstration prepared by Radiant InnovaTech. Leads, agents and figures shown are sample data.<% if (site.temporary) { %> Changes you make here are temporary and may disappear.<% } %></div><% } %>
<div class="utility"><div class="container">
  <span class="hide-sm"><%- icon('map-pin') %> <%= site.address %></span>
  <span class="cluster"><a href="tel:<%= site.phone.replace(/[^\d+]/g, '') %>"><%- icon('phone') %> <%= site.phone %></a><a class="hide-sm" href="mailto:<%= site.email %>"><%- icon('mail') %> <%= site.email %></a></span>
</div></div>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/"><span class="brand-mark">M</span><span><%= site.name.split(' ')[0] %><small><%= site.name.split(' ').slice(1).join(' ') || 'Construction' %></small></span></a>
    <button class="nav-toggle" data-nav-toggle aria-label="Menu" aria-expanded="false"><%- icon('menu') %></button>
    <nav class="main-nav" aria-label="Main">
      <a href="/#services">Services</a>
      <a href="/#projects">Projects</a>
      <a href="/#enquire">Contact</a>
      <a class="btn sm" href="/#enquire">Get a free quote</a>
    </nav>
  </div>
</header>
<main>
<% } %>
