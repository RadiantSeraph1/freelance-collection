<form method="post" action="/admin/leads/<%= l.id %>/assign" class="inline">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <select name="agent_id" aria-label="Assign <%= l.name %> to"><% agents.forEach((a) => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select>
  <button class="btn">Assign</button>
</form>
