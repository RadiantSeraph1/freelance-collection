<%- include('../partials/app-head', { active: 'properties' }) %>
  <div class="bar"><div><h1>Listings</h1><p class="muted"><%= properties.length %> properties on the website and in your records.</p></div><a class="btn" href="/admin/properties/new"><%- icon('plus') %> Add a listing</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th></th><th>Ref</th><th>Title</th><th>Location</th><th class="num">Price</th><th>Status</th><th class="num">Enquiries</th><th></th></tr></thead>
    <tbody><% properties.forEach((p) => { %><tr>
      <td><img class="thumb-sm" src="<%= thumb(p.image_url) %>" alt="" width="64" height="48" loading="lazy"></td>
      <td><%= p.ref %></td>
      <td><a href="/properties/<%= p.id %>"><%= p.title %></a><% if (p.featured) { %> <span class="tag accent">Featured</span><% } %></td>
      <td><%= p.location %></td>
      <td class="num"><%= money(p.price, p.currency) %></td>
      <td><span class="badge <%= p.status === 'available' ? 'ok' : 'warn' %>"><%= label(p.status) %></span></td>
      <td class="num"><%= p.enquiries %></td>
      <td><a href="/admin/properties/<%= p.id %>/edit">Edit</a></td>
    </tr><% }) %></tbody>
  </table></div>
<%- include('../partials/app-foot') %>
