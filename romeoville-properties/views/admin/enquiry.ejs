<%- include('../partials/head') %>
<%- include('nav') %>
  <p><a href="/admin/enquiries">← All enquiries</a></p>
  <h1><%= enquiry.name %></h1>
  <div class="two">
    <div>
      <dl class="specs">
        <div><dt>Phone</dt><dd><%= enquiry.phone || '–' %></dd></div>
        <div><dt>Email</dt><dd><%= enquiry.email || '–' %></dd></div>
        <div><dt>Source</dt><dd><%= label(enquiry.source) %></dd></div>
        <div><dt>Received</dt><dd><%= enquiry.created_at %> UTC</dd></div>
        <div><dt>Property</dt><dd><% if (enquiry.ref) { %><a href="/properties/<%= enquiry.property_id %>"><%= enquiry.ref %> – <%= enquiry.property_title %></a><% } else { %>General enquiry<% } %></dd></div>
      </dl>
      <h2>Message</h2>
      <p class="desc"><%= enquiry.message || 'No message.' %></p>
      <h2>History</h2>
      <% if (notes.length) { %><ul class="notes"><% notes.forEach((n) => { %><li><span class="muted"><%= n.created_at %> UTC · <%= n.author %></span><br><%= n.note %></li><% }) %></ul>
      <% } else { %><p class="muted">No notes yet.</p><% } %>
    </div>
    <form method="post" action="/admin/enquiries/<%= enquiry.id %>" class="stack panel">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2>Update</h2>
      <label>Stage <select name="status"><% ENQUIRY_STATUSES.forEach((s) => { %><option value="<%= s %>" <%= enquiry.status === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
      <label>Assigned to <input name="assigned_to" maxlength="60" value="<%= enquiry.assigned_to %>"></label>
      <label>Next follow-up <input name="next_follow_up" type="date" value="<%= enquiry.next_follow_up || '' %>"></label>
      <label>Add a note <textarea name="note" rows="4" maxlength="2000" placeholder="What was said, what happens next"></textarea></label>
      <button class="btn">Save</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
