<%- include('../partials/app-head', { active: 'dashboard' }) %>
  <div class="bar"><div><h1>Dashboard</h1><p class="muted">What needs your attention today.</p></div><a class="btn" href="/admin/enquiries/new"><%- icon('plus') %> Log an enquiry</a></div>
  <div class="stats">
    <a class="stat" href="/admin/enquiries?status=new"><b><%= stats.newEnquiries %></b>New enquiries</a>
    <a class="stat <%= stats.due ? 'alert' : '' %>" href="/admin/enquiries?due=1"><b><%= stats.due %></b>Follow-ups due</a>
    <a class="stat" href="/admin/enquiries?status=open"><b><%= stats.open %></b>Open enquiries</a>
    <a class="stat" href="/admin/properties"><b><%= stats.listings %></b>Available listings</a>
    <div class="stat"><b><%= stats.closed ? Math.round(100 * stats.won / stats.closed) + '%' : '–' %></b>Closed enquiries won</div>
  </div>

  <h2>Follow-ups due today or overdue</h2>
  <% if (due.length) { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Due</th><th>Customer</th><th>Property</th><th>Stage</th><th>Assigned to</th></tr></thead>
    <tbody><% due.forEach((e) => { %><tr>
      <td class="overdue"><%= e.next_follow_up %></td>
      <td><a href="/admin/enquiries/<%= e.id %>"><%= e.name %></a></td>
      <td><%= e.ref || 'General' %></td><td><span class="badge info"><%= label(e.status) %></span></td><td><%= e.assigned_to || 'Unassigned' %></td>
    </tr><% }) %></tbody>
  </table></div>
  <% } else { %><p class="notice ok">Nothing is due. Well done.</p><% } %>

  <div class="two mt-l">
    <div class="panel">
      <h2>Pipeline</h2>
      <% const total = ENQUIRY_STATUSES.reduce((a, s) => a + (byStatus[s] || 0), 0) || 1; %>
      <div class="bars"><% ENQUIRY_STATUSES.forEach((s) => { %>
        <a href="/admin/enquiries?status=<%= s %>" class="between"><span><%= label(s) %></span><strong><%= byStatus[s] || 0 %></strong></a>
        <progress class="meter" max="<%= total %>" value="<%= byStatus[s] || 0 %>"></progress>
      <% }) %></div>
    </div>
    <div class="panel">
      <h2>Where enquiries come from</h2>
      <div class="table-wrap"><table><thead><tr><th>Source</th><th class="num">Enquiries</th><th class="num">Won</th></tr></thead>
      <tbody><% bySource.forEach((s) => { %><tr><td><a href="/admin/enquiries?source=<%= s.source %>"><%= label(s.source) %></a></td><td class="num"><%= s.total %></td><td class="num"><%= s.won %></td></tr><% }) %></tbody></table></div>
    </div>
  </div>
<%- include('../partials/app-foot') %>
