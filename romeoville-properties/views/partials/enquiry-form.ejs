<% if (errors.length) { %><ul class="errors"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul><% } %>
<form method="post" action="/enquiries" class="stack">
  <% if (locals.property && property) { %><input type="hidden" name="property_id" value="<%= property.id %>"><% } %>
  <label>Your name <input name="name" required maxlength="100" value="<%= form.name || '' %>"></label>
  <label>Phone / WhatsApp <input name="phone" type="tel" maxlength="30" value="<%= form.phone || '' %>"></label>
  <label>Email <input name="email" type="email" maxlength="120" value="<%= form.email || '' %>"></label>
  <label>Message <textarea name="message" rows="4" maxlength="2000"><%= form.message || '' %></textarea></label>
  <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
  <button class="btn">Send enquiry</button>
</form>
