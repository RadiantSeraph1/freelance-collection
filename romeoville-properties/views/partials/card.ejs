<a class="card" href="/properties/<%= p.id %>">
  <% if (p.image_url) { %><img class="photo" src="<%= p.image_url %>" alt="<%= p.title %>" loading="lazy">
  <% } else { %><div class="photo ph ph-<%= p.type %>"><span><%= label(p.type) %></span></div><% } %>
  <div class="card-body">
    <div class="tags"><span class="tag"><%= label(p.listing) %></span><% if (p.status === 'under_offer') { %><span class="tag warn">Under offer</span><% } %></div>
    <h3><%= p.title %></h3>
    <p class="muted"><%= p.location %> · Ref <%= p.ref %></p>
    <p class="price"><%= money(p.price, p.currency) %><% if (p.listing === 'rent') { %><small> / month</small><% } %></p>
    <p class="facts">
      <% if (p.bedrooms !== null) { %><span><%= p.bedrooms %> bed</span><% } %>
      <% if (p.bathrooms !== null) { %><span><%= p.bathrooms %> bath</span><% } %>
      <% if (p.size_sqm !== null) { %><span><%= p.size_sqm.toLocaleString('en-US') %> m²</span><% } %>
    </p>
  </div>
</a>
