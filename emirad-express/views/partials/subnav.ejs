<nav class="subnav">
  <% const here = (p) => path === p || path.startsWith(p + '/'); %>
  <% if (me.role === 'manager') { %>
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'on' : '' %>">Dashboard</a>
    <a href="/admin/board" class="<%= here('/admin/board') ? 'on' : '' %>">Board</a>
    <a href="/admin/shipments" class="<%= here('/admin/shipments') && !here('/admin/shipments/new') ? 'on' : '' %>">Shipments</a>
    <a href="/admin/shipments/new" class="<%= here('/admin/shipments/new') ? 'on' : '' %>">New booking</a>
    <a href="/admin/cash" class="<%= here('/admin/cash') ? 'on' : '' %>">Cash</a>
    <a href="/admin/statements" class="<%= here('/admin/statements') ? 'on' : '' %>">Statements</a>
    <a href="/admin/reports" class="<%= here('/admin/reports') ? 'on' : '' %>">Reports</a>
    <a href="/admin/people" class="<%= here('/admin/people') ? 'on' : '' %>">Riders &amp; customers</a>
  <% } else if (me.role === 'rider') { %>
    <a href="/rider" class="<%= path === '/rider' || path === '/rider/' || here('/rider/jobs') ? 'on' : '' %>">My jobs</a>
    <a href="/rider/cash" class="<%= here('/rider/cash') ? 'on' : '' %>">My cash</a>
  <% } else { %>
    <a href="/account" class="<%= path === '/account' || path === '/account/' || here('/account/shipments') ? 'on' : '' %>">My parcels</a>
    <a href="/account/book" class="<%= here('/account/book') ? 'on' : '' %>">Book</a>
    <a href="/account/bulk" class="<%= here('/account/bulk') ? 'on' : '' %>">Book many</a>
    <a href="/account/statement" class="<%= here('/account/statement') ? 'on' : '' %>">Statement</a>
  <% } %>
  <span class="grow"></span>
  <a href="/account-settings/password">Password</a>
  <form method="post" action="/account-settings/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link"><%= me.name %> · Sign out</button></form>
</nav>
