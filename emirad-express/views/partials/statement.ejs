<h2><%= business.company %>: statement for <%= data.period %></h2>
<% if (!data.rows.length) { %><p class="empty">No parcels were completed in this month.</p><% } else { %>
<table>
  <thead><tr><th>Completed</th><th>Tracking</th><th>To</th><th>Result</th><th class="num">Delivery fee</th><th class="num">Cash collected for you</th></tr></thead>
  <tbody><% data.rows.forEach((r) => { %><tr>
    <td><%= r.closed_at.slice(0, 10) %></td><td><a class="mono" href="<%= base %>/<%= r.id %>"><%= r.tracking %></a></td><td><%= r.receiver_name %>, <%= r.delivery_zone %></td>
    <td><%= label(r.status) %></td><td class="num"><%= money(r.payment_mode === 'account' ? r.price : 0) %></td><td class="num"><%= money(r.cod_collected) %></td>
  </tr><% }) %></tbody>
</table>
<% } %>
<div class="stats">
  <div class="stat"><b><%= data.delivered %></b>Delivered</div>
  <div class="stat"><b><%= data.returned %></b>Returned</div>
  <div class="stat"><b><%= money(data.fees) %></b>Delivery fees</div>
  <div class="stat"><b><%= money(data.cod) %></b>Cash collected for you</div>
  <div class="stat"><b><%= data.net >= 0 ? money(data.net) : '− ' + money(-data.net) %></b><%= data.net >= 0 ? 'We owe you' : 'You owe us' %></div>
</div>
<p class="muted">Delivery fees are charged for parcels that were delivered or returned. Cash collected is what riders collected from receivers for you. The difference is what is owed to you, or to us. Use your browser’s print option and choose “Save as PDF” to keep a copy.</p>
