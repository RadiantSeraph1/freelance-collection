<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <div class="bar"><h1><%= me.company %></h1><div class="inline"><a class="btn" href="/account/book">Book a delivery</a> <a class="btn" href="/account/bulk">Book many</a></div></div>
  <div class="stats">
    <div class="stat"><b><%= stats.active %></b>On their way</div>
    <div class="stat"><b><%= stats.delivered %></b>Delivered</div>
    <div class="stat <%= stats.failed ? 'alert' : '' %>"><b><%= stats.failed %></b>Failed, being retried</div>
    <a class="stat" href="/account/statement"><b><%= money(stats.cod) %></b>Cash collected for you</a>
  </div>
  <h2>My parcels</h2>
  <%- include('../partials/ship-table', { rows: shipments, base: '/account/shipments' }) %>
</div>
<%- include('../partials/foot') %>
