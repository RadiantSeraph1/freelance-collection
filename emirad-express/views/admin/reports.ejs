<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <h1>Reports</h1>
  <% const max = Math.max(1, ...days.map((d) => d.n)); %>
  <div class="stats">
    <div class="stat"><b><%= delivered.n ? Math.round(100 * delivered.on_time / delivered.n) + '%' : '–' %></b>Delivered on time (<%= delivered.on_time || 0 %> of <%= delivered.n %>)</div>
    <div class="stat <%= cash.holding ? 'alert' : '' %>"><b><%= money(cash.holding) %></b>Cash riders still hold</div>
    <div class="stat <%= cash.short ? 'alert' : '' %>"><b><%= money(cash.short) %></b>Cash collected short</div>
  </div>
  <div class="two">
    <div>
      <h2>Bookings, last 14 days</h2>
      <% if (days.length) { %><table><tbody><% days.forEach((d) => { %><tr><td><%= d.d %></td><td class="wide"><progress class="meter" value="<%= d.n %>" max="<%= max %>"></progress></td><td class="num"><%= d.n %></td></tr><% }) %></tbody></table><% } else { %><p class="muted">None.</p><% } %>
      <h2>Revenue by service</h2>
      <table><thead><tr><th>Service</th><th class="num">Parcels</th><th class="num">Revenue</th></tr></thead><tbody><% byService.forEach((r) => { %><tr><td><%= label(r.service) %></td><td class="num"><%= r.n %></td><td class="num"><%= money(r.revenue) %></td></tr><% }) %></tbody></table>
      <h2>Why deliveries failed</h2>
      <% if (failures.length) { %><table><tbody><% failures.forEach((f) => { %><tr><td><%= label(f.reason) %></td><td class="num"><%= f.n %></td></tr><% }) %></tbody></table><% } else { %><p class="muted">No failures.</p><% } %>
    </div>
    <div>
      <h2>Riders</h2>
      <table><thead><tr><th>Rider</th><th class="num">Delivered</th><th class="num">Failed attempts</th><th class="num">Avg hours to deliver</th></tr></thead><tbody><% riders.forEach((r) => { %><tr><td><%= r.name %></td><td class="num"><%= r.delivered || 0 %></td><td class="num"><%= r.failed_attempts || 0 %></td><td class="num"><%= r.hours ?? '–' %></td></tr><% }) %></tbody></table>
      <h2>Customers</h2>
      <table><thead><tr><th>Customer</th><th class="num">Parcels</th><th class="num">Revenue</th></tr></thead><tbody><% byCustomer.forEach((c) => { %><tr><td><%= c.customer %></td><td class="num"><%= c.n %></td><td class="num"><%= money(c.revenue) %></td></tr><% }) %></tbody></table>
      <h2>Where parcels are now</h2>
      <table><tbody><% byStatus.forEach((s) => { %><tr><td><a href="/admin/shipments?status=<%= s.status %>"><%= label(s.status) %></a></td><td class="num"><%= s.n %></td></tr><% }) %></tbody></table>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
