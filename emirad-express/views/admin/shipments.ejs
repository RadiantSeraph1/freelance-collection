<%- include('../partials/head') %>
<div class="wrap section">
<%- include('../partials/subnav') %>
  <div class="bar"><h1>Shipments</h1><div class="inline"><a href="/admin/shipments.csv">Download CSV</a> <a class="btn" href="/admin/shipments/new">New booking</a></div></div>
  <form class="filters" action="/admin/shipments">
    <label>Search <input name="q" value="<%= f.q %>" placeholder="Tracking, name, phone"></label>
    <label>Status <select name="status"><option value="">All</option><option value="active" <%= f.status === 'active' ? 'selected' : '' %>>All active</option><% STATUSES.forEach((s) => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= label(s) %></option><% }) %></select></label>
    <label>Service <select name="service"><option value="">All</option><% Object.keys(SERVICES).forEach((k) => { %><option value="<%= k %>" <%= f.service === k ? 'selected' : '' %>><%= SERVICES[k].name %></option><% }) %></select></label>
    <label>Rider <select name="rider"><option value="">All</option><option value="none" <%= f.rider === 'none' ? 'selected' : '' %>>No rider</option><% riders.forEach((r) => { %><option value="<%= r.id %>" <%= f.rider === String(r.id) ? 'selected' : '' %>><%= r.name %></option><% }) %></select></label>
    <label>Customer <select name="business"><option value="">All</option><% businesses.forEach((b) => { %><option value="<%= b.id %>" <%= f.business === b.id ? 'selected' : '' %>><%= b.company %></option><% }) %></select></label>
    <label>Booked on <input name="date" type="date" value="<%= f.date %>"></label>
    <div class="actions"><button class="btn">Filter</button> <a href="/admin/shipments">Clear</a></div>
  </form>
  <p class="muted"><%= shipments.length %> shipment<%= shipments.length === 1 ? '' : 's' %></p>
  <%- include('../partials/ship-table', { rows: shipments, base: '/admin/shipments' }) %>
</div>
<%- include('../partials/foot') %>
